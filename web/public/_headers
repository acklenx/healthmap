# Cache policy at the edge.
#
# Two kinds of file here, and they want opposite things.
#
# Stamped assets carry ?cache-id=<content hash> (see scripts/stamp_assets.py),
# so a given URL's bytes never change and it can be cached about as hard as it
# is possible to cache something. A release mints new URLs.
#
# Entry points cannot be stamped -- something has to be fetched by a stable URL
# for the rest to be discovered at all -- so those revalidate every time. It is
# a few small conditional requests that mostly come back 304, and the service
# worker is what actually makes this app work offline. The HTTP cache was never
# doing that job; on sw.js it was actively delaying releases.

/sw.js
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/version.json
  Cache-Control: no-cache

# Stamped by scripts/stamp_assets.py. Safe to keep forever: the id changes with
# the contents, so a stale copy is a copy of a URL nobody asks for any more.
/app.js
  Cache-Control: public, max-age=31536000, immutable

/styles.css
  Cache-Control: public, max-age=31536000, immutable

/qr.js
  Cache-Control: public, max-age=31536000, immutable

# County geography. Boundaries do not move; this changes only if the gazetteer
# vintage does, which is a deliberate act.
/georgia.json
  Cache-Control: public, max-age=604800

/manifest.webmanifest
  Cache-Control: public, max-age=31536000, immutable

/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/icons/*
  Cache-Control: public, max-age=31536000, immutable

# Only ever fetched when a browser offers to install the app, so a week-old
# copy costs nothing. Not stamped for the same reason -- it is not worth a
# bucket of its own to save a request nobody makes twice.
/screenshots/*
  Cache-Control: public, max-age=604800

# Stamped by the crawler as ?v=<generated> rather than by stamp_assets.py --
# the data changes on a different schedule to the app.
/counties.json
  Cache-Control: public, max-age=31536000, immutable

/places/*
  Cache-Control: public, max-age=31536000, immutable

# Same stamp as the payload, same reasoning.
/history/*
  Cache-Control: public, max-age=31536000, immutable
